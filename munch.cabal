cabal-version:       3.0
name:                munch
version:             0.0.0.0
synopsis:            See README for more info
description:
    See README for more info.
    See [README.md](https://github.com/dsunshi/munch#munch) for more details.
homepage:            https://github.com/dsunshi/munch
bug-reports:         https://github.com/dsunshi/munch/issues
license:             MIT
license-file:        LICENSE
author:              D. Sunshine
maintainer:          D. Sunshine <david@sunshines.org>
copyright:           2026 D. Sunshine
build-type:          Simple
extra-doc-files:     README.md
                     CHANGELOG.md
tested-with:         GHC == 9.8.4
                     GHC == 9.10.3

source-repository head
  type:                git
  location:            https://github.com/dsunshi/munch.git

common common-options
  build-depends:       base >= 4.19.2.0 && < 4.21

  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
                       -Wnoncanonical-monad-instances
  if impl(ghc >= 8.2)
    ghc-options:       -fhide-source-paths
  if impl(ghc >= 8.4)
    ghc-options:       -Wmissing-export-lists
                       -Wpartial-fields
  if impl(ghc >= 8.8)
    ghc-options:       -Wmissing-deriving-strategies
                       -fwrite-ide-info
                       -hiedir=.hie
  if impl(ghc >= 8.10)
    ghc-options:       -Wunused-packages
  if impl(ghc >= 9.0)
    ghc-options:       -Winvalid-haddock
  if impl(ghc >= 9.2)
    ghc-options:       -Wredundant-bang-patterns
                       -Woperator-whitespace
  if impl(ghc >= 9.4  && < 9.10)
    ghc-options:       -Wforall-identifier
  if impl(ghc >= 9.4)
    ghc-options:       -Wredundant-strictness-flags
  if impl(ghc >= 9.8)
    ghc-options:       -Wterm-variable-capture
                       -Winconsistent-flags
  if impl(ghc >= 9.10)
    ghc-options:       -Wincomplete-record-selectors
                       -Wdeprecated-type-abstractions
                       -Wdata-kinds-tc
                       -Wdefaulted-exception-context
  if impl(ghc >= 9.12)
    ghc-options:       -Wview-pattern-signatures

  default-language:    Haskell2010
  default-extensions:  OverloadedStrings
                       FlexibleInstances
                       DerivingStrategies
                       DeriveGeneric
                       GADTs
                       OverloadedRecordDot
                       DuplicateRecordFields

library
  import:              common-options
  build-depends:       linear, lens
  hs-source-dirs:      src
  exposed-modules:     Munch, Turtle

executable munch
  import:              common-options
  hs-source-dirs:      app
  main-is:             Main.hs
  build-depends:       munch
  ghc-options:         -threaded
                       -rtsopts
                       -with-rtsopts=-N

test-suite munch-test
  import:              common-options
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  build-depends:       munch, hspec, linear
  ghc-options:         -threaded
                       -rtsopts
                       -with-rtsopts=-N
